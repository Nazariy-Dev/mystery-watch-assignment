{
  "expo": {
    "name": "Mystery Watch",
    "slug": "mystery-watch",
    "scheme": "mysterywatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mysterywatch.app"
    },
    "android": {
      "package": "com.mysterywatch.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B1A",
        "foregroundImage": "./assets/app/android-icon-foreground.png",
        "backgroundImage": "./assets/app/android-icon-background.png",
        "monochromeImage": "./assets/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/unbounded/700Bold/Unbounded_700Bold.ttf",
              "node_modules/@expo-google-fonts/unbounded/800ExtraBold/Unbounded_800ExtraBold.ttf",
              "node_modules/@expo-google-fonts/manrope/500Medium/Manrope_500Medium.ttf",
              "node_modules/@expo-google-fonts/manrope/600SemiBold/Manrope_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Unbounded",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/unbounded/700Bold/Unbounded_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/unbounded/800ExtraBold/Unbounded_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/manrope/500Medium/Manrope_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/manrope/600SemiBold/Manrope_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B1A",
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-asset"
    ],
    "backgroundColor": "#0B0B1A"
  }
}
